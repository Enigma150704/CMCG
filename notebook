rob = probs.numpy()\n    y_pred = preds.numpy()\n\n    fpr, tpr, _ = roc_curve(y_true, y_prob)\n    roc_auc     = auc(fpr, tpr)\n    prec, rec, _ = precision_recall_curve(y_true, y_prob)\n    pr_auc       = auc(rec, prec)\n    acc          = (preds == lab_t.cpu()).float().mean().item()\n    fp_rate      = ((preds == 0) & (lab_t.cpu() == 1)).float().mean().item()\n    fn_rate      = ((preds == 1) & (lab_t.cpu() == 0)).float().mean().item()\n\n    return {\n        \"Model\": name, \"Accuracy\": round(acc, 4),\n        \"ROC AUC\": round(roc_auc, 4), \"PR AUC\": round(pr_auc, 4),\n        \"False Positive Rate\": round(fp_rate, 4), \"False Negative Rate\": round(fn_rate, 4),\n        \"_fpr\": fpr, \"_tpr\": tpr, \"_roc_auc\": roc_auc,\n    }\n\n# Baseline: threshold on cosine similarity\ntest_cos_only  = test_cos_t.cpu()\ntest_baseline_logits = (test_cos_only - threshold.item())  # positive = above threshold = consistent\nbaseline_res = {\n    \"Model\": \"Baseline (cosine threshold)\", \"Accuracy\": round(overall_acc, 4),\n    \"ROC AUC\": round(roc_auc, 4), \"PR AUC\": \"N/A\",\n    \"False Positive Rate\": round((test_baseline_logits[test_lab_t.cpu()==0] > 0).float().mean().item(), 4),\n    \"False Negative Rate\": round((test_baseline_logits[test_lab_t.cpu()==1] <= 0).float().mean().item(), 4),\n    \"_fpr\": fpr, \"_tpr\": tpr, \"_roc_auc\": roc_auc,\n}\n\nmlp_res  = evaluate_model(model,      test_img_t, test_cap_t, test_cos_t, test_lab_t, \"Consistency MLP (Week 5)\")\nattn_res = evaluate_model(attn_model, test_img_t, test_cap_t, test_cos_t, test_lab_t, \"Attention Scorer (Week 7)\")\n\ncomp_table = pd.DataFrame([\n    {k: v for k, v in r.items() if not k.startswith(\"_\")}\n    for r in [baseline_res, mlp_res, attn_res]\n])\ncomp_table.to_csv(\"/kaggle/working/week8_comparative_results.csv\", index=False)\nprint(\"=== FINAL COMPARATIVE RESULTS TABLE ===\")\nprint(comp_table.to_string(index=False))\n","metadata":{"trusted":true,"execution":{"iopub.status.busy"