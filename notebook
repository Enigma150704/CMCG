rn\n\nimport os, random, warnings\nimport numpy as np\nimport pandas as pd\nimport torch\nimport torch.nn.functional as F\nfrom PIL import Image\nimport matplotlib\nimport matplotlib.pyplot as plt\nimport matplotlib.cm as cm\nfrom sklearn.metrics import (classification_report, confusion_matrix,\n                              ConfusionMatrixDisplay, roc_curve, auc,\n                              precision_recall_curve)\nimport networkx as nx\nwarnings.filterwarnings(\"ignore\")\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(\"Device:\", device)\nSEED = 42\nrandom.seed(SEED); np.random.seed(SEED); torch.manual_seed(SEED)\nprint(\"All libraries loaded successfully.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:44:15.925729Z","iopub.execute_input":"2026-07-27T05:44:15.92639Z","iopub.status.idle":"2026-07-27T05:44:28.342214Z","shell.execute_reply.started":"2026-07-27T05:44:15.926358Z","shell.execute_reply":"2026-07-27T05:44:28.341311Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Load CLIP (core multimodal model) ─────────────────────────────────────────\n# CLIP (Contrastive Language-Image Pre-Training) by OpenAI produces aligned\n# embeddings for both images and text in the same 512-dim vector space.\n# This alignment is the backbone of the entire cross-modal consistency pipeline.\nfrom transformers import CLIPModel, CLIPProcessor\n\nCLIP_NAME = \"openai/clip-vit-base-patch32\"\nclip_model = CLIPModel.from_pretrained(CLIP_NAME).to(device)\nclip_processor = CLIPProcessor.from_pretrained(CLIP_NAME)\nclip_model.eval()\nprint(\"CLIP model loaded:\", CLIP_NAME)\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:44:28.34384Z","iopub.execute_input":"2026-07-27T05:44:28.344402Z","iopub.status.idle":"2026-07-27T05:44:55.187951Z","shell.execute_reply.started":"2026-07-27T05:44:28.344375Z","shell.execute_reply":"2026-07-27T05:44:55.187288Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Week 1: Sanity check — verify embedding shapes and similarity concept ─────\ndummy_img = Image.new(\"RGB\", (224, 224), color=(120, 160, 200))\ndummy_text = [\"a blue square image\"]\n\ninputs = clip_processor(text=dummy_text, images=dummy_img,\n                         return_tensors=\"pt\", padding=True).to(device)\nwith torch.no_grad():\n    out = clip_model(**inputs)\n\nimg_emb = F.normalize(out.image_embeds, dim=-1)\ntxt_emb = F.normalize(out.text_embeds, dim=-1)\nsim = (img_emb * txt_emb).sum().item()\n\nprint(f\"Image embedding shape : {img_emb.shape}\")\nprint(f\"Text  embedding shape : {txt_emb.shape}\")\nprint(f\"Cosine similarity     : {sim:.4f}\")\nprint(\"Week 1 complete: CLIP verified, embeddings are 512-dim, similarity range [−1, 1]\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:44:55.188897Z","iopub.execute_input":"2026-07-27T05:44:55.189417Z","iopub.status.idle":"2026-07-27T05:44:56.926539Z","shell.execute_reply.started":"2026-07-27T05:44:55.189391Z","shell.execute_reply":"2026-07-27T05:44:56.925675Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## ── WEEK 2 ── Dataset Collection & Preprocessing\n**Topics:** Multimodal datasets, feature preprocessing, embedding fundamentals\n**Tasks:** Download dataset, preprocess text and images, generate and cache embeddings\n**Deliverables:** Cleaned dataset, embedding generation notebook\n\nDataset: Flickr30k — 31,000+ images each paired with 5 human-written captions.\nWe use 1,500 images (one caption each) for fast iteration on Kaggle free GPU.\n\n> Run `!ls /kaggle/input/flickr-image-dataset/` to confirm mount path after adding via Add Data.\n","metadata":{}},{"cell_type":"code","source":"# ── Dataset paths — adjust if your mount path differs ─────────────────────────\n# !ls /kaggle/input/flickr-image-dataset/\n# !ls /kaggle/input/flickr-image-dataset/flickr30k_images/\n\nDATA_DIR    = \"/kaggle/input/datasets/hsankesara/flickr-image-dataset/flickr30k_images\"\nIMAGES_DIR  = os.path.join(DATA_DIR, \"flickr30k_images\")\nCAPTIONS_CSV = os.path.join(DATA_DIR, \"results.csv\")\n\n# Full dataset — all unique images in Flickr30k (~31,000)\n# No N_SAMPLES cap. Embedding generation will take ~15-20 min on T4 GPU.\n\ndf = pd.read_csv(CAPTIONS_CSV, delimiter=\"|\")\ndf.columns = [c.strip() for c in df.columns]\nprint(\"Columns found:\", list(df.columns))\nprint(\"Total rows:\", len(df))\ndf.head()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:44:56.928469Z","iopub.execute_input":"2026-07-27T05:44:56.928703Z","iopub.status.idle":"2026-07-27T05:44:57.93866Z","shell.execute_reply.started":"2026-07-27T05:44:56.928682Z","shell.execute_reply":"2026-07-27T05:44:57.938021Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Clean — one caption per image, full dataset ───────────────────────────────\ndef clean_caption(text):\n    text = str(text).strip()\n    if not text.endswith((\".\", \"!\", \"?\")):\n        text = text + \".\"\n    return text\n\n# Keep one caption per image (first occurrence), use ALL images\ndf_subset = df.dropna().drop_duplicates(subset=[\"image_name\"]).reset_index(drop=True)\ndf_subset[\"caption_clean\"] = df_subset[\"comment\"].apply(clean_caption)\nprint(f\"Full dataset: {len(df_subset)} image-caption pairs\")\n\ndef load_image(name):\n    return Image.open(os.path.join(IMAGES_DIR, name)).convert(\"RGB\").resize((224, 224))\n\n# Quick visual check — show 4 samples\nfig, axes = plt.subplots(1, 4, figsize=(14, 3))\nfor ax, i in zip(axes, range(4)):\n    ax.imshow(load_image(df_subset.loc[i, \"image_name\"]))\n    ax.set_title(df_subset.loc[i, \"caption_clean\"][:40] + \"...\", fontsize=7)\n    ax.axis(\"off\")\nplt.suptitle(\"Sample Flickr30k image-caption pairs (full dataset)\", fontsize=10)\nplt.tight_layout()\nplt.savefig(\"/kaggle/working/week2_sample_pairs.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:44:57.939636Z","iopub.execute_input":"2026-07-27T05:44:57.939962Z","iopub.status.idle":"2026-07-27T05:44:58.821323Z","shell.execute_reply.started":"2026-07-27T05:44:57.939928Z","shell.execute_reply":"2026-07-27T05:44:58.820449Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Generate & cache CLIP embeddings ──────────────────────────────────────────\n# Save to disk immediately — if the session restarts, we don't recompute.\nos.makedirs(\"/kaggle/working/embeddings\", exist_ok=True)\n\nBATCH = 32\nimage_embeds_all, text_embeds_all = [], []\n\nfor start in range(0, len(df_subset), BATCH):\n    batch = df_subset.iloc[start:start+BATCH]\n    imgs  = [load_image(n) for n in batch[\"image_name\"]]\n    caps  = list(batch[\"caption_clean\"])\n    inputs = clip_processor(text=caps, images=imgs, return_tensors=\"pt\",\n                             padding=True, truncation=True).to(device)\n    with torch.no_grad():\n        out = clip_model(**inputs)\n    image_embeds_all.append(out.image_embeds.cpu())\n    text_embeds_all.append(out.text_embeds.cpu())\n    print(f\"  Processed {start+len(batch)}/{len(df_subset)}\", end=\"\\r\")\n\nimage_embeds_all = F.normalize(torch.cat(image_embeds_all, dim=0), dim=-1)\ntext_embeds_all  = F.normalize(torch.cat(text_embeds_all,  dim=0), dim=-1)\n\ntorch.save(image_embeds_all, \"/kaggle/working/embeddings/image_embeds.pt\")\ntorch.save(text_embeds_all,  \"/kaggle/working/embeddings/text_embeds.pt\")\ndf_subset.to_csv(\"/kaggle/working/embeddings/subset_meta.csv\", index=False)\n\nprint(f\"\\nImage embeddings : {image_embeds_all.shape}\")\nprint(f\"Text  embeddings : {text_embeds_all.shape}\")\nprint(\"All embeddings saved to /kaggle/working/embeddings/\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:44:58.822678Z","iopub.execute_input":"2026-07-27T05:44:58.823022Z","iopub.status.idle":"2026-07-27T05:52:01.44629Z","shell.execute_reply.started":"2026-07-27T05:44:58.822993Z","shell.execute_reply":"2026-07-27T05:52:01.445591Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Embedding space analysis (Week 2 extra) ───────────────────────────────────\n# Visualise the embedding space using PCA (2D projection).\n# Matched pairs should cluster together; mismatched should be further apart.\nfrom sklearn.decomposition import PCA\n\npca = PCA(n_components=2, random_state=SEED)\nimg_2d = pca.fit_transform(image_embeds_all.numpy())\ntxt_2d = pca.transform(text_embeds_all.numpy())\n\nplt.figure(figsize=(7, 5))\nplt.scatter(img_2d[:200, 0], img_2d[:200, 1], c=\"steelblue\",  alpha=0.5, s=15, label=\"Image embeds\")\nplt.scatter(txt_2d[:200, 0], txt_2d[:200, 1], c=\"darkorange\", alpha=0.5, s=15, label=\"Caption embeds\")\nfor i in range(0, 40, 4):   # draw lines connecting matched pairs\n    plt.plot([img_2d[i,0], txt_2d[i,0]], [img_2d[i,1], txt_2d[i,1]],\n             \"gray\", alpha=0.3, linewidth=0.7)\nplt.xlabel(\"PCA-1\"); plt.ylabel(\"PCA-2\")\nplt.title(\"PCA projection of CLIP image & caption embeddings (200 pairs)\")\nplt.legend(); plt.tight_layout()\nplt.savefig(\"/kaggle/working/week2_pca_embedding_space.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\nprint(\"Week 2 complete: embeddings generated, PCA visualisation saved.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:01.447427Z","iopub.execute_input":"2026-07-27T05:52:01.447687Z","iopub.status.idle":"2026-07-27T05:52:02.227877Z","shell.execute_reply.started":"2026-07-27T05:52:01.447663Z","shell.execute_reply":"2026-07-27T05:52:02.227298Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## ── WEEK 3 ── Baseline Multimodal Model\n**Topics:** Multimodal fusion, similarity learning\n**Tasks:** Build simple image-text matching system, evaluate semantic similarity\n**Deliverables:** Baseline multimodal model, similarity analysis report\n","metadata":{}},{"cell_type":"code","source":"# ── Load cached embeddings ────────────────────────────────────────────────────\nimage_embeds_all = torch.load(\"/kaggle/working/embeddings/image_embeds.pt\")\ntext_embeds_all  = torch.load(\"/kaggle/working/embeddings/text_embeds.pt\")\ndf_subset        = pd.read_csv(\"/kaggle/working/embeddings/subset_meta.csv\")\nN = image_embeds_all.shape[0]\nprint(f\"Loaded {N} image and caption embeddings (512-dim each).\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:02.228679Z","iopub.execute_input":"2026-07-27T05:52:02.229295Z","iopub.status.idle":"2026-07-27T05:52:02.410077Z","shell.execute_reply.started":"2026-07-27T05:52:02.229219Z","shell.execute_reply":"2026-07-27T05:52:02.409107Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Cosine similarity — matched vs mismatched ─────────────────────────────────\nmatched_sim = (image_embeds_all * text_embeds_all).sum(dim=-1)\n\n# Build mismatched pairs using a shuffled permutation (no pair maps to itself)\nperm = torch.randperm(N)\nperm = torch.tensor([p if p != i else (p + 1) % N for i, p in enumerate(perm)])\nmismatched_sim = (image_embeds_all * text_embeds_all[perm]).sum(dim=-1)\n\nprint(f\"Matched   pairs — mean: {matched_sim.mean():.4f}  std: {matched_sim.std():.4f}\")\nprint(f\"Mismatched pairs — mean: {mismatched_sim.mean():.4f}  std: {mismatched_sim.std():.4f}\")\nprint(f\"Separation (delta mean): {matched_sim.mean() - mismatched_sim.mean():.4f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:02.411269Z","iopub.execute_input":"2026-07-27T05:52:02.412027Z","iopub.status.idle":"2026-07-27T05:52:02.713106Z","shell.execute_reply.started":"2026-07-27T05:52:02.411993Z","shell.execute_reply":"2026-07-27T05:52:02.712287Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Similarity distribution + ROC curve ───────────────────────────────────────\nfig, axes = plt.subplots(1, 2, figsize=(13, 4))\n\n# Distribution\naxes[0].hist(matched_sim.numpy(),    bins=40, alpha=0.65, color=\"green\",  label=\"Matched (consistent)\")\naxes[0].hist(mismatched_sim.numpy(), bins=40, alpha=0.65, color=\"crimson\",label=\"Mismatched (inconsistent)\")\nthreshold = (matched_sim.mean() + mismatched_sim.mean()) / 2\naxes[0].axvline(threshold.item(), color=\"black\", linestyle=\"--\", label=f\"Threshold={threshold:.3f}\")\naxes[0].set_xlabel(\"Cosine Similarity\"); axes[0].set_ylabel(\"Count\")\naxes[0].set_title(\"Week 3: Matched vs Mismatched Similarity\")\naxes[0].legend()\n\n# ROC\ny_true  = torch.cat([torch.ones(N), torch.zeros(N)]).numpy()\ny_score = torch.cat([matched_sim, mismatched_sim]).numpy()\nfpr, tpr, _ = roc_curve(y_true, y_score)\nroc_auc = auc(fpr, tpr)\naxes[1].plot(fpr, tpr, color=\"steelblue\", lw=2, label=f\"ROC AUC = {roc_auc:.4f}\")\naxes[1].plot([0,1],[0,1],\"k--\")\naxes[1].set_xlabel(\"False Positive Rate\"); axes[1].set_ylabel(\"True Positive Rate\")\naxes[1].set_title(\"Week 3: ROC Curve — Baseline Classifier\")\naxes[1].legend()\n\nplt.tight_layout()\nplt.savefig(\"/kaggle/working/week3_baseline_analysis.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n\n# Accuracy\nacc_matched    = (matched_sim    > threshold).float().mean().item()\nacc_mismatched = (mismatched_sim <= threshold).float().mean().item()\noverall_acc    = (acc_matched + acc_mismatched) / 2\nprint(f\"Baseline accuracy — Matched: {acc_matched:.4f} | Mismatched: {acc_mismatched:.4f} | Overall: {overall_acc:.4f}\")\nprint(f\"ROC AUC: {roc_auc:.4f}\")\nprint(\"Week 3 complete.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:02.718005Z","iopub.execute_input":"2026-07-27T05:52:02.718433Z","iopub.status.idle":"2026-07-27T05:52:03.656715Z","shell.execute_reply.started":"2026-07-27T05:52:02.718395Z","shell.execute_reply":"2026-07-27T05:52:03.656012Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Top-K retrieval evaluation (Image → Caption) ──────────────────────────────\n# For each image, rank all 1500 captions by similarity and check if the\n# correct caption appears in the top-K. Standard cross-modal retrieval metric.\nsim_matrix = image_embeds_all @ text_embeds_all.T  # (N, N)\n\nfor k in [1, 5, 10]:\n    topk_indices = sim_matrix.topk(k, dim=1).indices\n    correct = sum(i in topk_indices[i].tolist() for i in range(N))\n    print(f\"  Image→Caption Recall@{k:<2}: {correct/N:.4f}  ({correct}/{N} correct)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:03.657696Z","iopub.execute_input":"2026-07-27T05:52:03.658052Z","iopub.status.idle":"2026-07-27T05:52:12.989967Z","shell.execute_reply.started":"2026-07-27T05:52:03.658024Z","shell.execute_reply":"2026-07-27T05:52:12.988917Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## ── WEEK 4 ── Cross-Modal Consistency Graph Design\n**Topics:** Graph representation learning, similarity graph construction\n**Tasks:** Create graph structures, define node and edge semantics, compute consistency scores\n**Deliverables:** Initial graph framework, graph visualization results\n\n**Graph schema:**\n- **Nodes:** one image node + one caption node per sample (2N nodes total)\n- **Positive edges** (label=1): image_i ↔ caption_i, weight = cosine similarity (trust score)\n- **Negative edges** (label=0): image_i ↔ random caption_j, weight = cosine similarity (low trust)\n","metadata":{}},{"cell_type":"code","source":"# ── Build the Cross-Modal Consistency Graph ───────────────────────────────────\nG = nx.Graph()\n\nfor i in range(N):\n    G.add_node(f\"img_{i}\", type=\"image\",   embed_idx=i)\n    G.add_node(f\"cap_{i}\", type=\"caption\", embed_idx=i)\n\n# Positive (consistent) edges\nfor i in range(N):\n    G.add_edge(f\"img_{i}\", f\"cap_{i}\",\n               weight=matched_sim[i].item(), label=1, edge_type=\"consistent\")\n\n# Negative (inconsistent) edges — same random permutation as Week 3\nfor i in range(N):\n    j = perm[i].item()\n    G.add_edge(f\"img_{i}\", f\"cap_{j}\",\n               weight=mismatched_sim[i].item(), label=0, edge_type=\"inconsistent\")\n\nprint(f\"Graph: {G.number_of_nodes()} nodes, {G.number_of_edges()} edges\")\nprint(f\"  Consistent edges   : {sum(1 for _,_,d in G.edges(data=True) if d['label']==1)}\")\nprint(f\"  Inconsistent edges : {sum(1 for _,_,d in G.edges(data=True) if d['label']==0)}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:12.991186Z","iopub.execute_input":"2026-07-27T05:52:12.991815Z","iopub.status.idle":"2026-07-27T05:52:13.936522Z","shell.execute_reply.started":"2026-07-27T05:52:12.991778Z","shell.execute_reply":"2026-07-27T05:52:13.935758Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Graph visualisation ───────────────────────────────────────────────────────\nsub_nodes = [f\"img_{i}\" for i in range(20)] + [f\"cap_{i}\" for i in range(20)]\nGsub = G.subgraph(sub_nodes).copy()\n\npos = nx.spring_layout(Gsub, seed=SEED, k=0.8)\nedge_colors  = [\"#2ecc71\" if d[\"label\"]==1 else \"#e74c3c\" for _,_,d in Gsub.edges(data=True)]\nedge_widths  = [2.5 if d[\"label\"]==1 else 1.0 for _,_,d in Gsub.edges(data=True)]\nnode_colors  = [\"#3498db\" if Gsub.nodes[n][\"type\"]==\"image\" else \"#f39c12\" for n in Gsub.nodes]\n\nplt.figure(figsize=(11, 8))\nnx.draw_networkx(Gsub, pos, node_color=node_colors, edge_color=edge_colors,\n                  width=edge_widths, node_size=400, font_size=6, alpha=0.9)\nfrom matplotlib.lines import Line2D\nlegend_elements = [\n    Line2D([0],[0], marker=\"o\", color=\"w\", markerfacecolor=\"#3498db\", markersize=10, label=\"Image node\"),\n    Line2D([0],[0], marker=\"o\", color=\"w\", markerfacecolor=\"#f39c12\", markersize=10, label=\"Caption node\"),\n    Line2D([0],[0], color=\"#2ecc71\", lw=2.5, label=\"Consistent edge\"),\n    Line2D([0],[0], color=\"#e74c3c\", lw=1.0, label=\"Inconsistent edge\"),\n]\nplt.legend(handles=legend_elements, loc=\"upper left\", fontsize=8)\nplt.title(\"Cross-Modal Consistency Graph — 20-sample subgraph\")\nplt.axis(\"off\")\nplt.tight_layout()\nplt.savefig(\"/kaggle/working/week4_graph_visualization.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:13.937594Z","iopub.execute_input":"2026-07-27T05:52:13.937883Z","iopub.status.idle":"2026-07-27T05:52:14.39741Z","shell.execute_reply.started":"2026-07-27T05:52:13.937859Z","shell.execute_reply":"2026-07-27T05:52:14.396738Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Graph-level consistency statistics ────────────────────────────────────────\nconsistent_weights   = [d[\"weight\"] for _,_,d in G.edges(data=True) if d[\"label\"]==1]\ninconsistent_weights = [d[\"weight\"] for _,_,d in G.edges(data=True) if d[\"label\"]==0]\n\nprint(f\"Consistent edge weights   — mean: {np.mean(consistent_weights):.4f}  std: {np.std(consistent_weights):.4f}\")\nprint(f\"Inconsistent edge weights — mean: {np.mean(inconsistent_weights):.4f}  std: {np.std(inconsistent_weights):.4f}\")\n\n# Graph-level trust score = fraction of edges above threshold\ntrust_scores = {n: [] for n in G.nodes()}\nfor u, v, d in G.edges(data=True):\n    trust_scores[u].append(d[\"weight\"])\n    trust_scores[v].append(d[\"weight\"])\n\nnode_trust = {n: np.mean(ws) for n, ws in trust_scores.items()}\nimg_trust  = [v for k,v in node_trust.items() if k.startswith(\"img_\")]\ncap_trust  = [v for k,v in node_trust.items() if k.startswith(\"cap_\")]\nprint(f\"Mean node trust — image nodes: {np.mean(img_trust):.4f} | caption nodes: {np.mean(cap_trust):.4f}\")\nprint(\"Week 4 complete.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:14.398332Z","iopub.execute_input":"2026-07-27T05:52:14.398617Z","iopub.status.idle":"2026-07-27T05:52:15.024062Z","shell.execute_reply.started":"2026-07-27T05:52:14.398594Z","shell.execute_reply":"2026-07-27T05:52:15.023457Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## ── WEEK 5 ── Consistency Classifier (Trust-Aware, Inductive)\n**Topics:** Graph Neural Networks, attention mechanisms, trust propagation\n**Tasks:** Implement consistency model, train graph-based classifier\n**Deliverables:** GNN model notebook, graph learning analysis\n\n**Design rationale (learned through debugging):**\n- Raw 512-dim CLIP embeddings → encoder overfits severely (classic small-n / large-p problem)\n- GraphSAGE transductive design failed at test time on unseen isolated pairs\n- Final fix: compact 2-feature classifier (cosine similarity + L2 distance) — fully inductive,\n  no graph-neighbor dependency at scoring time, generalizes to any new pair\n- Split by **image** (not pair) to prevent identity-memorization leakage\n","metadata":{}},{"cell_type":"code","source":"# ── Build training pairs (image-level split) ──────────────────────────────────\nfrom torch_geometric.data import Data\nfrom torch_geometric.nn import SAGEConv\n\nfeat_dim = image_embeds_all.shape[1]  # 512\n\n# Build node feature matrix for the graph (kept for graph structure / Week 7 trust propagation)\nnode_list = list(G.nodes())\nnode_idx  = {n: i for i, n in enumerate(node_list)}\nx = torch.zeros((len(node_list), feat_dim))\nfor n in node_list:\n    idx = int(n.split(\"_\")[1])\n    x[node_idx[n]] = image_embeds_all[idx] if n.startswith(\"img_\") else text_embeds_all[idx]\n\nedge_src, edge_dst, edge_labels, edge_weights = [], [], [], []\nfor u, v, d in G.edges(data=True):\n    edge_src.append(node_idx[u]); edge_dst.append(node_idx[v])\n    edge_labels.append(d[\"label\"]); edge_weights.append(d[\"weight\"])\n\nedge_index   = torch.tensor([edge_src, edge_dst], dtype=torch.long)\nedge_index   = torch.cat([edge_index, edge_index.flip(0)], dim=1)\nedge_labels_t = torch.tensor(edge_labels, dtype=torch.float)\ndata = Data(x=x, edge_index=edge_index).to(device)\nprint(\"PyG Data:\", data)\n\n# Split by IMAGE to prevent leakage\nimg_perm   = torch.randperm(N)\ntrain_end  = int(0.70 * N)\nval_end    = int(0.85 * N)\ntrain_img_idx = img_perm[:train_end]\nval_img_idx   = img_perm[train_end:val_end]\ntest_img_idx  = img_perm[val_end:]\n\ndef build_pairs(idxs):\n    ai   = torch.cat([image_embeds_all[idxs], image_embeds_all[idxs]])\n    ac   = torch.cat([text_embeds_all[idxs],  text_embeds_all[perm][idxs]])\n    acos = (ai * ac).sum(-1)\n    al   = torch.cat([torch.ones(len(idxs)), torch.zeros(len(idxs))])\n    return ai.to(device), ac.to(device), acos.to(device), al.to(device)\n\ntrain_img_t, train_cap_t, train_cos_t, train_lab_t = build_pairs(train_img_idx)\nval_img_t,   val_cap_t,   val_cos_t,   val_lab_t   = build_pairs(val_img_idx)\ntest_img_t,  test_cap_t,  test_cos_t,  test_lab_t  = build_pairs(test_img_idx)\nprint(f\"train={len(train_lab_t)} val={len(val_lab_t)} test={len(test_lab_t)} pairs\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:15.02497Z","iopub.execute_input":"2026-07-27T05:52:15.025301Z","iopub.status.idle":"2026-07-27T05:52:17.979167Z","shell.execute_reply.started":"2026-07-27T05:52:15.025272Z","shell.execute_reply":"2026-07-27T05:52:17.978453Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Consistency Classifier ────────────────────────────────────────────────────\nclass ConsistencyClassifier(torch.nn.Module):\n    \"\"\"Compact inductive classifier using only two geometric features:\n    - cosine similarity  (semantic alignment — same signal as the baseline)\n    - L2 distance        (geometric separation in the normalised embedding sphere)\n    Two features → cannot memorise per-image identity → must generalise.\n    \"\"\"\n    def __init__(self, hidden_dim=8):\n        super().__init__()\n        self.mlp = torch.nn.Sequential(\n            torch.nn.Linear(2, hidden_dim),\n            torch.nn.ReLU(),\n            torch.nn.Linear(hidden_dim, 1)\n        )\n\n    def forward(self, img_emb, cap_emb, cos_sim):\n        l2   = (img_emb - cap_emb).pow(2).sum(-1).sqrt()\n        feat = torch.stack([cos_sim, l2], dim=-1)\n        return self.mlp(feat).squeeze(-1)\n\nmodel     = ConsistencyClassifier().to(device)\noptimizer = torch.optim.Adam(model.parameters(), lr=1e-2, weight_decay=1e-4)\nscheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n    optimizer, mode=\"min\", factor=0.5, patience=15)\n\ntotal_params = sum(p.numel() for p in model.parameters())\nprint(f\"Model parameters: {total_params}  (intentionally small to prevent overfitting)\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:17.98026Z","iopub.execute_input":"2026-07-27T05:52:17.980773Z","iopub.status.idle":"2026-07-27T05:52:17.991188Z","shell.execute_reply.started":"2026-07-27T05:52:17.980743Z","shell.execute_reply":"2026-07-27T05:52:17.990663Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Training loop ─────────────────────────────────────────────────────────────\nEPOCHS = 300\nbest_val_loss = float(\"inf\")\nbest_state    = None\ntrain_losses, val_losses, val_accs = [], [], []\n\nfor epoch in range(1, EPOCHS + 1):\n    model.train()\n    optimizer.zero_grad()\n    logits = model(train_img_t, train_cap_t, train_cos_t)\n    loss   = F.binary_cross_entropy_with_logits(logits, train_lab_t)\n    loss.backward()\n    optimizer.step()\n\n    model.eval()\n    with torch.no_grad():\n        vlogits  = model(val_img_t, val_cap_t, val_cos_t)\n        val_loss = F.binary_cross_entropy_with_logits(vlogits, val_lab_t).item()\n        val_acc  = ((torch.sigmoid(vlogits) > 0.5).float() == val_lab_t).float().mean().item()\n\n    scheduler.step(val_loss)\n    train_losses.append(loss.item()); val_losses.append(val_loss); val_accs.append(val_acc)\n\n    if val_loss < best_val_loss:\n        best_val_loss = val_loss\n        best_state = {k: v.clone() for k, v in model.state_dict().items()}\n\n    if epoch % 30 == 0 or epoch == 1:\n        print(f\"Epoch {epoch:3d} | train {loss.item():.4f} | val {val_loss:.4f} | val_acc {val_acc:.4f}\")\n\nmodel.load_state_dict(best_state)\nmodel.eval()\nwith torch.no_grad():\n    t_logits  = model(test_img_t, test_cap_t, test_cos_t)\n    test_pred = (torch.sigmoid(t_logits) > 0.5).float()\n    test_acc  = (test_pred == test_lab_t).float().mean().item()\nprint(f\"\\nFinal TEST accuracy (best checkpoint): {test_acc:.4f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:17.992203Z","iopub.execute_input":"2026-07-27T05:52:17.992602Z","iopub.status.idle":"2026-07-27T05:52:19.259137Z","shell.execute_reply.started":"2026-07-27T05:52:17.992576Z","shell.execute_reply":"2026-07-27T05:52:19.258459Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Training curves + classification report ────────────────────────────────────\nfig, axes = plt.subplots(1, 2, figsize=(13, 4))\n\naxes[0].plot(train_losses, label=\"Train loss\", color=\"steelblue\")\naxes[0].plot(val_losses,   label=\"Val loss\",   color=\"darkorange\")\naxes[0].set_xlabel(\"Epoch\"); axes[0].set_ylabel(\"BCE Loss\")\naxes[0].set_title(\"Week 5: Training & Validation Loss\")\naxes[0].legend()\n\naxes[1].plot(val_accs, color=\"green\")\naxes[1].set_xlabel(\"Epoch\"); axes[1].set_ylabel(\"Validation Accuracy\")\naxes[1].set_title(\"Week 5: Validation Accuracy over Training\")\naxes[1].set_ylim(0, 1.05)\n\nplt.tight_layout()\nplt.savefig(\"/kaggle/working/week5_training_curves.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n\n# Classification report\ny_pred_np = test_pred.cpu().numpy()\ny_true_np = test_lab_t.cpu().numpy()\nprint(\"\\nClassification Report:\")\nprint(classification_report(y_true_np, y_pred_np, target_names=[\"Inconsistent\", \"Consistent\"]))\n\n# Confusion matrix\ncm_disp = ConfusionMatrixDisplay(confusion_matrix(y_true_np, y_pred_np),\n          