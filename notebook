lf  = gnn_score(fake_img_e, fake_cap_e)\nresults[\"fake_caption_swap\"] = {\n    \"baseline_mean_sim\": f_sim.mean().item(),\n    \"baseline_flagged_rate\": (f_sim < threshold).float().mean().item(),\n    \"classifier_mean_score\": f_clf.mean().item(),\n    \"classifier_flagged_rate\": (f_clf < 0.5).float().mean().item(),\n}\nprint(f\"fake_caption_swap: baseline_flagged={results['fake_caption_swap']['baseline_flagged_rate']:.3f}  \"\n      f\"classifier_flagged={results['fake_caption_swap']['classifier_flagged_rate']:.3f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:19.983863Z","iopub.execute_input":"2026-07-27T05:52:19.98426Z","iopub.status.idle":"2026-07-27T05:52:45.731024Z","shell.execute_reply.started":"2026-07-27T05:52:19.984196Z","shell.execute_reply":"2026-07-27T05:52:45.730192Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Attack results summary table + bar chart ──────────────────────────────────\nsummary_rows = []\nfor atk, r in results.items():\n    summary_rows.append({\n        \"Attack\": atk,\n        \"Baseline Mean Sim\": round(r[\"baseline_mean_sim\"], 4),\n        \"Baseline Flagged\": round(r[\"baseline_flagged_rate\"], 4),\n        \"Classifier Score\": round(r[\"classifier_mean_score\"], 4),\n        \"Classifier Flagged\": round(r[\"classifier_flagged_rate\"], 4),\n    })\nsummary_df = pd.DataFrame(summary_rows)\nsummary_df.to_csv(\"/kaggle/working/week6_attack_summary.csv\", index=False)\nprint(summary_df.to_string(index=False))\n\n# Bar chart\nfig, ax = plt.subplots(figsize=(10, 4))\nx = np.arange(len(summary_df))\nw = 0.35\nax.bar(x - w/2, summary_df[\"Baseline Flagged\"],   w, label=\"Baseline (cosine threshold)\", color=\"#e74c3c\", alpha=0.8)\nax.bar(x + w/2, summary_df[\"Classifier Flagged\"], w, label=\"Trained Classifier\",          color=\"#3498db\", alpha=0.8)\nax.set_xticks(x); ax.set_xticklabels(summary_df[\"Attack\"], rotation=15, ha=\"right\")\nax.set_ylabel(\"Flagged Rate (fraction detected as inconsistent)\")\nax.set_title(\"Week 6: Attack Detection — Baseline vs Trained Classifier\")\nax.legend(); ax.set_ylim(0, 1.1)\nplt.tight_layout()\nplt.savefig(\"/kaggle/working/week6_attack_bar_chart.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\nprint(\"Week 6 complete.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:45.732078Z","iopub.execute_input":"2026-07-27T05:52:45.7325Z","iopub.status.idle":"2026-07-27T05:52:46.079747Z","shell.execute_reply.started":"2026-07-27T05:52:45.732421Z","shell.execute_reply":"2026-07-27T05:52:46.078973Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## ── WEEK 7 ── Secure & Trust-Aware Enhancements + Explainability\n**Topics:** Trust-aware graph scoring, robust multimodal reasoning, Explainable AI\n**Tasks:** Improve graph robustness, add explainability mechanisms\n**Deliverables:** Enhanced secure graph framework, explainability visualizations\n\n**Three components this week:**\n1. **Trust propagation** — propagate trust scores through the graph (nodes with many high-trust edges get a higher global trust rating)\n2. **Attention-based consistency scoring** — a simple attention mechanism that weights the importance of cosine-sim vs L2 features per pair\n3. **Explainability** — feature importance analysis showing what the model relies on, and per-sample consistency explanation visualizations\n","metadata":{}},{"cell_type":"code","source":"# ── 7A: Trust Propagation over the Consistency Graph ─────────────────────────\n# Each node starts with its own edge-weight average as a local trust score.\n# We then propagate: a node's trust is refined by its neighbours' trust scores\n# (weighted by the edge connecting them). This mirrors how trust works in social\n# networks and is the graph-theoretic contribution of the CMCG framework.\n\ndef compute_trust_scores(G, iterations=5, damping=0.85):\n    \"\"\"Iterative trust propagation (analogous to PageRank / label propagation).\n    trust_new[v] = (1 - damping) + damping * sum_{u ~ v} (w(u,v) * trust[u]) / degree(v)\n    \"\"\"\n    # Initialise: local trust = mean edge weight for each node\n    trust = {}\n    for n in G.nodes():\n        ws = [d[\"weight\"] for _, _, d in G.edges(n, data=True)]\n        trust[n] = np.mean(ws) if ws else 0.5\n\n    for _ in range(iterations):\n        new_trust = {}\n        for n in G.nodes():\n            neighbours = list(G.neighbors(n))\n            if not neighbours:\n                new_trust[n] = trust[n]\n                continue\n            weighted_sum = sum(G[n][nb][\"weight\"] * trust[nb] for nb in neighbours)\n            degree       = sum(G[n][nb][\"weight\"] for nb in neighbours)\n            new_trust[n] = (1 - damping) + damping * (weighted_sum / degree)\n        trust = new_trust\n\n    return trust\n\ntrust_scores = compute_trust_scores(G, iterations=10, damping=0.85)\n\nimg_trust_vals = [v for k, v in trust_scores.items() if k.startswith(\"img_\")]\ncap_trust_vals = [v for k, v in trust_scores.items() if k.startswith(\"cap_\")]\n\nprint(f\"Trust score stats — Image nodes: mean={np.mean(img_trust_vals):.4f}  std={np.std(img_trust_vals):.4f}\")\nprint(f\"Trust score stats — Caption nodes: mean={np.mean(cap_trust_vals):.4f}  std={np.std(cap_trust_vals):.4f}\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:46.080736Z","iopub.execute_input":"2026-07-27T05:52:46.081114Z","iopub.status.idle":"2026-07-27T05:52:49.439974Z","shell.execute_reply.started":"2026-07-27T05:52:46.081086Z","shell.execute_reply":"2026-07-27T05:52:49.439276Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Visualise trust propagation on the subgraph ───────────────────────────────\nsub_nodes = [f\"img_{i}\" for i in range(20)] + [f\"cap_{i}\" for i in range(20)]\nGsub = G.subgraph(sub_nodes).copy()\n\ntrust_vals = np.array([trust_scores.get(n, 0.5) for n in Gsub.nodes()])\nnode_colors = [plt.cm.RdYlGn(v) for v in trust_vals]  # red=low trust, green=high trust\nedge_colors = [\"#2ecc71\" if d[\"label\"]==1 else \"#e74c3c\" for _,_,d in Gsub.edges(data=True)]\npos = nx.spring_layout(Gsub, seed=SEED, k=0.8)\n\nplt.figure(figsize=(11, 8))\nnx.draw_networkx(Gsub, pos, node_color=node_colors, edge_color=edge_colors,\n                  node_size=500, font_size=6, width=1.5)\nsm = plt.cm.ScalarMappable(cmap=plt.cm.RdYlGn, norm=plt.Normalize(vmin=0, vmax=1))\nsm.set_array([])\nplt.colorbar(sm, ax=plt.gca(), shrink=0.7, label=\"Node trust score\")\nplt.title(\"Week 7: Trust-Propagated Consistency Graph (red=low trust, green=high trust)\")\nplt.axis(\"off\"); plt.tight_layout()\nplt.savefig(\"/kaggle/working/week7_trust_propagation_graph.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:49.441155Z","iopub.execute_input":"2026-07-27T05:52:49.4416Z","iopub.status.idle":"2026-07-27T05:52:49.919609Z","shell.execute_reply.started":"2026-07-27T05:52:49.441569Z","shell.execute_reply":"2026-07-27T05:52:49.918714Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── 7B: Attention-Weighted Consistency Scorer ─────────────────────────────────\n# Instead of treating cosine_sim and L2 equally, a learned attention mechanism\n# decides which feature matters more for each pair. Provides richer explanations:\n# for a given pair, we can say \"this decision was driven 80% by semantic similarity\n# and 20% by geometric distance.\"\n\nclass AttentionConsistencyScorer(torch.nn.Module):\n    \"\"\"Extends ConsistencyClassifier with a 2-head attention over the two features.\n    Attention weights are interpretable: they show which feature drives each decision.\n    \"\"\"\n    def __init__(self, hidden_dim=16):\n        super().__init__()\n        self.attn = torch.nn.Sequential(\n            torch.nn.Linear(2, hidden_dim),\n            torch.nn.Tanh(),\n            torch.nn.Linear(hidden_dim, 2),\n            torch.nn.Softmax(dim=-1)           # produces attention weights summing to 1\n        )\n        self.scorer = torch.nn.Sequential(\n            torch.nn.Linear(2, hidden_dim),\n            torch.nn.ReLU(),\n            torch.nn.Linear(hidden_dim, 1)\n        )\n\n    def forward(self, img_emb, cap_emb, cos_sim, return_attn=False):\n        l2   = (img_emb - cap_emb).pow(2).sum(-1).sqrt()\n        feat = torch.stack([cos_sim, l2], dim=-1)\n        attn_w = self.attn(feat)              # (batch, 2) — importance of each feature\n        feat_w = feat * attn_w               # attention-weighted features\n        logit  = self.scorer(feat_w).squeeze(-1)\n        if return_attn:\n            return logit, attn_w\n        return logit\n\nattn_model = AttentionConsistencyScorer().to(device)\nattn_optimizer = torch.optim.Adam(attn_model.parameters(), lr=1e-2, weight_decay=1e-4)\n\nbest_val_loss_attn = float(\"inf\")\nbest_state_attn    = None\n\nfor epoch in range(1, 301):\n    attn_model.train()\n    attn_optimizer.zero_grad()\n    logits = attn_model(train_img_t, train_cap_t, train_cos_t)\n    loss   = F.binary_cross_entropy_with_logits(logits, train_lab_t)\n    loss.backward(); attn_optimizer.step()\n\n    attn_model.eval()\n    with torch.no_grad():\n        vlogits  = attn_model(val_img_t, val_cap_t, val_cos_t)\n        val_loss = F.binary_cross_entropy_with_logits(vlogits, val_lab_t).item()\n\n    if val_loss < best_val_loss_attn:\n        best_val_loss_attn = val_loss\n        best_state_attn = {k: v.clone() for k, v in attn_model.state_dict().items()}\n\n    if epoch % 60 == 0 or epoch == 1:\n        print(f\"Epoch {epoch:3d} | loss {loss.item():.4f} | val_loss {val_loss:.4f}\")\n\nattn_model.load_state_dict(best_state_attn)\nattn_model.eval()\nwith torch.no_grad():\n    t_logits  = attn_model(test_img_t, test_cap_t, test_cos_t)\n    test_pred = (torch.sigmoid(t_logits) > 0.5).float()\n    attn_test_acc = (test_pred == test_lab_t).float().mean().item()\nprint(f\"\\nAttention model TEST accuracy: {attn_test_acc:.4f}\")\ntorch.save(attn_model.state_dict(), \"/kaggle/working/embeddings/attention_model.pt\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:49.920698Z","iopub.execute_input":"2026-07-27T05:52:49.92116Z","iopub.status.idle":"2026-07-27T05:52:51.154797Z","shell.execute_reply.started":"2026-07-27T05:52:49.92113Z","shell.execute_reply":"2026-07-27T05:52:51.153783Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── 7C: Explainability — Feature Importance & Per-Sample Analysis ─────────────\n\n# 1. Global feature importance: mean attention weights over test set\nattn_model.eval()\nwith torch.no_grad():\n    _, attn_weights = attn_model(test_img_t, test_cap_t, test_cos_t, return_attn=True)\n\nmean_attn = attn_weights.mean(dim=0).cpu().numpy()\nprint(f\"Mean attention weight — cosine_sim: {mean_attn[0]:.4f} | L2_distance: {mean_attn[1]:.4f}\")\n\nfig, axes = plt.subplots(1, 3, figsize=(15, 4))\n\n# Attention weight distribution\naxes[0].hist(attn_weights[:,0].cpu().numpy(), bins=30, alpha=0.7, color=\"steelblue\",  label=\"Cosine sim weight\")\naxes[0].hist(attn_weights[:,1].cpu().numpy(), bins=30, alpha=0.7, color=\"darkorange\", label=\"L2 dist weight\")\naxes[0].set_title(\"Feature Attention Weight Distribution\"); axes[0].legend()\naxes[0].set_xlabel(\"Attention weight\")\n\n# Attention weights per-sample scatter (cosine-sim-driven vs L2-driven)\ncos_w_np = attn_weights[:,0].cpu().numpy()\nl2_w_np  = attn_weights[:,1].cpu().numpy()\npred_np  = (torch.sigmoid(t_logits) > 0.5).cpu().numpy()\ncolors   = [\"#2ecc71\" if p else \"#e74c3c\" for p in pred_np]\naxes[1].scatter(cos_w_np, l2_w_np, c=colors, alpha=0.5, s=15)\naxes[1].set_xlabel(\"Attention on cosine_sim\"); axes[1].set_ylabel(\"Attention on L2 dist\")\naxes[1].set_title(\"Per-sample attention (green=consistent, red=inconsistent)\")\n\n# Feature importance bar chart\naxes[2].bar([\"Cosine Similarity\", \"L2 Distance\"], mean_attn,\n            color=[\"steelblue\", \"darkorange\"], alpha=0.85)\naxes[2].set_ylabel(\"Mean Attention Weight\"); axes[2].set_ylim(0, 1)\naxes[2].set_title(\"Global Feature Importance (Attention)\")\n\nplt.tight_layout()\nplt.savefig(\"/kaggle/working/week7_explainability_attention.png\", dpi=150, bbox_inches=\"tight\")\nplt.show()\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-07-27T05:52:51.155947Z","iopub.execute_input":"2026-07-27T05:52:51.156293Z","iopub.status.idle":"2026-07-27T05:52:52.496596Z","shell.execute_reply.started":"2026-07-27T05:52:51.156252Z","shell.execute_reply":"2026-07-27T05:52:52.495913Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── 7D: Per-sample consistency explanation (qualitative) ──────────────────────\n# Show a few images with their captions, model score, and attention breakdown.\n# This is what \"explainability\" means in practice for this system.\nattn_model.eval()\nsample_idx = list(range(8))\ns_img_e = image_embeds_all[sample_idx].to(device)\ns_cap_e = text_embeds_all[sample_idx].to(device)\ns_cos   = (s_img_e * s_cap_e).sum(-1)\n\nwith torch.no_grad():\n    s_logits, s_attn = attn_model(s_img_e, s_cap_e, s_cos, return_attn=True)\n    s_scores = torch.sigmoid(s_logits).cpu().numpy()\n    s_attn   = s_attn.cpu().numpy()\n\nfig, axes = plt.subplots(2, 4, figsize=(16, 7))\nfor ax, i in zip(axes.flat, sample_idx):\n    img = load_image(df_subset.loc[i, \"image_name\"])\n    cap = df_subset.loc[i, \"caption_clean\"]\n    score     = s_scores[i]\n    cos_w     = s_attn[i][0]\n    l2_w      = s_attn[i][1]\n    border_c  = \"#2ecc71\" if score > 0.5 else \"#e74c3c\"\n\n    ax.imshow(img)\n    ax.axis(\"off\")\n    verdict = \"CONSISTENT\" if score > 0.5 else \"INCONSISTENT\"\n    ax.set_title(\n        f\"{verdict}  (score={score:.2f})\\n\"\n        f\"Caption: {cap[:35]}...\\n\"\n        f\"Attn: cos={cos_w:.2f} | L2={l2_w:.2f}